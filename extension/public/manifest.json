{
  "manifest_version": 3,
  "name": "SteadyUI",
  "version": "0.1.0",
  "description": "Adaptive accessibility for motor impairments.",

  "action": {
    "default_title": "Open SteadyUI Calibration"
  },

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
